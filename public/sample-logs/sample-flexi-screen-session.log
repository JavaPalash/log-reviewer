	payload.put("pallet",       "");
	payload.put("palletNumber", "");
	payload.put("LABEL_TYPE",   "OB");
	payload.put("order",        orderNum      != null ? orderNum      : "");

} else {
	flexi.setStatusMessage("Invalid Label Type Selected: " + labelType);
	return;
}

String finalPayloadString = payload.toString();
logger.trace("Final Payload: " + finalPayloadString);
flexi.putSessionObject("PAYLOAD", finalPayloadString);
flexi.setStatusMessage("Payload Created:  " +flexi.getSessionObject("PAYLOAD"));
