	//payload.put("carton",       ""); previously new code added below
	
	if(XX_LPN_LABEL.getValue().length()>0)
	{
		payload.put("carton", lpnLabel);
	}
	else
	{
		payload.put("carton", "");
	}
	
	payload.put("printerName",  printerName   != null ? printerName   : "");
	//payload.put("pallet",      ""); Previously new code added below
	
	if(XX_PALLET_LABEL.getValue().length()>0)
	{
		payload.put("pallet", palletLabel   != null ? palletLabel   : "");
	}
	else
	{
		payload.put("pallet", palletLabel   != null ? palletLabel   : "");
	}
	
	if(XX_PALLET_LABEL.getValue().length()>0)
	{
		payload.put("palletNumber", palletLabel   != null ? palletLabel   : "");
	}
	else
	{
		payload.put("palletNumber", palletLabel   != null ? palletLabel   : "");
	}
	
	payload.put("LABEL_TYPE",   "OB");
	payload.put("order",        "");

} else if ("Order".equals(labelType)) {
	// ============================================================
	// Order Type Payload
	// ============================================================
	payload.put("LPNNumber",    "");
