} else if ("OB Label".equals(labelType)) {
	// ============================================================
	// OB Label Payload
	// ============================================================
	if(XX_LPN_LABEL.getValue().length()>0)
	{
		payload.put("LPNNumber", lpnLabel);
	}
	else
	{
		payload.put("LPNNumber", "");
