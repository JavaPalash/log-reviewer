	logger.trace("Result of TRANSACTION_DFF query: " + queryArr.get(0)[0]);

		logger.trace("TRANSACTION_DFF found. Extracting meaning...");

		Object transactionDFF = queryArr.get(0)[0];
		flexi.putObject("DFF_ATT_API_NAME", queryArr.get(0)[1]);
		flexi.putObject("TRANSACTION_DFF", transactionDFF);
		logger.trace("TRANSACTION_DFF set to: " + transactionDFF);

		// Extract Attribute2 to Attribute10 values
		Set attributeFieldNames = new HashSet();
		for (int i = 3; i <= 10; i++) {
			Object attr = queryArr.get(0)[i];
			if (attr != null && !attr.toString().trim().isEmpty()) {
				attributeFieldNames.add(attr.toString().trim());
			}
		}

		// If all attributes are empty, skip filtering
		boolean shouldFilter = !attributeFieldNames.isEmpty();

		String AttributesQuery = "SELECT * FROM XX_FSCM_DFF_SEGMENTS WHERE oracle_flexfield_code=? and COMPANY_ID=?";
		logger.trace("Executing AttributesQuery with oracle_flexfield_code: " + transactionDFF);

		ArrayList fieldsList = flexi.executeQuery(AttributesQuery, new String[]{String.valueOf(transactionDFF),companyId});
		logger.trace("Result of AttributesQuery: " + fieldsList);

		if (fieldsList.size() > 0)
		{
			if (shouldFilter)
			{
				logger.trace("Filtering AttributesQuery result based on mapped attribute names: " + attributeFieldNames);

				ArrayList filteredList = new ArrayList();
				for (int i = 0; i < fieldsList.size(); i++) {
					Object[] row = (Object[]) fieldsList.get(i);
					if (row[6] != null && attributeFieldNames.contains(row[6].toString().trim())) {
						filteredList.add(row);
					}
				}
	
				if (filteredList.isEmpty())
				{
					logger.trace("Mapping does not match any attribute in AttributesQuery result.");
					// Removing  all related objects from session
					flexi.removeObject("TRANSACTION_DFF");
					flexi.removeObject("DFF_ATT_API_NAME");

					// Set the status message
					flexi.setStatusMessage("Dff Field mapping mismatch with Oracle.");

					// Stop further processing
					return;
				} else
				{
					logger.trace("Filtered fields matched with mapping: " + filteredList);
					fieldsList = filteredList;
				}
			}
			else
			{
				logger.trace("No attribute mapping provided. Keeping original fieldsList.");
			}

			// Put the (filtered or original) list into session
			flexi.putObject("DFF_FIELDS", fieldsList);
			logger.trace("DFF_FIELDS stored in session.");
			
			Button button = new Button("CAPTURE_DFF", page.getContext());
			button.setLabel("Capture DFF");
			int submitIndex = div1.getChildPosition("SUBMIT");
			
		     button.addEventListener(new ButtonEventListener() {
